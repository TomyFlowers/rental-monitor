# Copy to .env (git-ignored) and fill in. Never commit the real file.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use the bot and
# receive alerts (get yours from @userinfobot). Each person must press
# Start on the bot once before it can message them.
TELEGRAM_ALLOWED_USER_IDS=

# Only if email.enabled is true in config.yaml: login of the dedicated mailbox
# that receives the alert emails (for Gmail, an app password).
# EMAIL_USER=
# EMAIL_PASSWORD=

# Optional overrides
# CONFIG_PATH=/app/config/config.yaml
# DATA_DIR=/app/data
# LOG_DIR=/app/logs
# LOG_LEVEL=info

# Only for docker compose: owner of the data/ and logs/ folders on the NAS
# (run `id` over SSH to see yours).
# PUID=1000
# PGID=1000
