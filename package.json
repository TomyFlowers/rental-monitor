{
  "name": "rental-monitor",
  "version": "0.2.0",
  "private": true,
  "description": "Monitors rental listings, scores them against configurable criteria and notifies a private Telegram bot",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "probe": "tsx src/cli/probe.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "croner": "^11.0.0",
    "grammy": "^1.46.0",
    "imapflow": "^2.12.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "postal-mime": "^4.2.1",
    "robots-parser": "^3.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
